<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="SudokuGameView" parent="AdwBreakpointBin">
    <child>
      <object class="GtkLabel" id="paused_label">
        <property name="label" translatable="yes">Paused</property>
      </object>
    </child>
    <property name="child">
      <object class="AdwToolbarView">
        <property name="top-bar-style">raised</property>
        <property name="bottom-bar-style">raised</property>
        <child type="top">
          <object class="AdwHeaderBar" id="top_headerbar">
            <property name="centering-policy">strict</property>
            <property name="title-widget">
              <object class="AdwWindowTitle" id="windowtitle">
                <property name="title" translatable="yes">Rascacielos</property>
              </object>
            </property>
            <child type="start">
              <object class="GtkButton" id="undo_button">
                <property name="tooltip-text" translatable="yes">Undo Action</property>
                <property name="focus-on-click">false</property>
                <property name="action-name">game-view.undo</property>
                <property name="icon-name">edit-undo-symbolic</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="redo_button">
                <property name="tooltip-text" translatable="yes">Redo Action</property>
                <property name="focus-on-click">false</property>
                <property name="action-name">game-view.redo</property>
                <property name="icon-name">edit-redo-symbolic</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkToggleButton" id="earmark_mode_button">
                <property name="tooltip-text" translatable="yes">Earmark Mode</property>
                <property name="focus-on-click">false</property>
                <property name="action-name">game-view.earmark-mode</property>
                <property name="icon-name">rascacielos-pencil-symbolic</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkStack" id="play_pause_stack">
                <property name="transition-type">crossfade</property>
                <property name="visible">false</property>
                <child>
                  <object class="GtkButton" id="pause_button">
                    <property name="tooltip-text" translatable="yes">Pause</property>
                    <property name="focus-on-click">false</property>
                    <property name="action-name">game-view.toggle-pause</property>
                    <property name="icon-name">rascacielos-pause-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="play_button">
                    <property name="tooltip-text" translatable="yes">Play</property>
                    <property name="focus-on-click">false</property>
                    <property name="action-name">game-view.toggle-pause</property>
                    <property name="icon-name">rascacielos-play-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="end">
              <object class="SudokuMenuButton" id="menu_button"/>
            </child>
            <child type="end">
              <object class="GtkBox" id="clock_box">
                <property name="can-focus">false</property>
                <property name="spacing">6</property>
                <!-- The margin aligns it vertically with the bottom bar buttons -->
                <property name="margin-start">9</property>
                <child>
                  <object class="GtkStack" id="clock_stack">
                    <child>
                      <object class="GtkImage" id="clock_image">
                        <property name="can-focus">false</property>
                        <property name="icon-name">rascacielos-clock-symbolic</property>
                        <property name="icon-size">normal</property>
                        <accessibility>
                          <property name="label" translatable="yes">Clock</property>
                        </accessibility>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="clock_medal">
                        <property name="label">🥇</property>
                        <property name="can-focus">false</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="clock_label">
                    <property name="can-focus">false</property>
                    <style>
                      <class name="numeric"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child type="bottom">
          <object class="AdwHeaderBar" id="bottom_headerbar">
            <property name="visible">false</property>
            <property name="show-title">false</property>
            <property name="decoration-layout">:</property>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="AdwBin" id="grid_bin">
                <child>
                  <object class="GtkOverlay" id="grid_overlay"/>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
    <child>
      <object class="AdwBreakpoint" id="ui_breakpoint">
        <condition>max-aspect-ratio: 3/4</condition>
        <setter object="bottom_headerbar" property="visible">true</setter>
      </object>
    </child>
  </template>
</interface>
