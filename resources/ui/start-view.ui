<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="SudokuStartView" parent="AdwBin">
    <child>
      <object class="AdwToolbarView">
        <property name="top-bar-style">raised</property>
        <child type="top">
          <object class="AdwHeaderBar" id="headerbar">
            <property name="centering-policy">strict</property>
            <property name="title-widget">
              <object class="AdwWindowTitle" id="windowtitle">
                <property name="title" translatable="yes">Rascacielos</property>
                <property name="subtitle" translatable="yes">New Puzzle</property>
              </object>
            </property>
            <child type="start">
              <object class="GtkButton" id="back_button">
                <property name="visible">false</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="tooltip-text" translatable="yes">Back</property>
                <property name="use-underline">true</property>
                <property name="action-name">app.back</property>
                <property name="icon-name">go-previous-symbolic</property>
              </object>
            </child>
            <child type="end">
              <object class="SudokuMenuButton" id="menu_button"/>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwStatusPage">
            <property name="title" translatable="yes">Select Puzzle Size and Difficulty</property>
            <property name="valign">start</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">400</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="AdwToggleGroup" id="size_group">
                        <property name="halign">center</property>
                        <property name="margin-bottom">24</property>
                        <signal name="notify::active-name" handler="size_changed_cb" swapped="True"/>
                        <accessibility>
                          <property name="label" translatable="yes">Puzzle Size</property>
                        </accessibility>
                        <child>
                          <object class="AdwToggle">
                            <property name="name">4</property>
                            <property name="label">4×4</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwToggle">
                            <property name="name">5</property>
                            <property name="label">5×5</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwToggle">
                            <property name="name">6</property>
                            <property name="label">6×6</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwToggle">
                            <property name="name">7</property>
                            <property name="label">7×7</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwActionRow">
                            <child type="prefix">
                              <object class="GtkCheckButton" id="custom_check">
                                <property name="group">easy_check</property>
                                <property name="can-focus">false</property>
                                <property name="can-target">false</property>
                              </object>
                            </child>
                            <property name="title" translatable="yes" context="Difficulty">_Custom</property>
                            <property name="use-underline">true</property>
                            <property name="activatable-widget">custom_check</property>
                            <signal name="activated" handler="custom_checkbutton_activated_cb" swapped="True"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwActionRow">
                            <child type="prefix">
                              <object class="GtkCheckButton" id="easy_check">
                                <property name="can-focus">false</property>
                                <property name="can-target">false</property>
                              </object>
                            </child>
                            <property name="title" translatable="yes" context="Difficulty">_Easy</property>
                            <property name="use-underline">true</property>
                            <property name="activatable-widget">easy_check</property>
                            <signal name="activated" handler="difficulty_checkbutton_activated_cb" swapped="True"/>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <child type="prefix">
                              <object class="GtkCheckButton" id="medium_check">
                                <property name="group">easy_check</property>
                                <property name="can-focus">false</property>
                                <property name="can-target">false</property>
                              </object>
                            </child>
                            <property name="title" translatable="yes" context="Difficulty">_Medium</property>
                            <property name="use-underline">true</property>
                            <property name="activatable-widget">medium_check</property>
                            <signal name="activated" handler="difficulty_checkbutton_activated_cb" swapped="True"/>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <child type="prefix">
                              <object class="GtkCheckButton" id="hard_check">
                                <property name="group">easy_check</property>
                                <property name="can-focus">false</property>
                                <property name="can-target">false</property>
                              </object>
                            </child>
                            <property name="title" translatable="yes" context="Difficulty">_Hard</property>
                            <property name="use-underline">true</property>
                            <property name="activatable-widget">hard_check</property>
                            <signal name="activated" handler="difficulty_checkbutton_activated_cb" swapped="True"/>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="very_hard_row">
                            <child type="prefix">
                              <object class="GtkCheckButton" id="very_hard_check">
                                <property name="group">easy_check</property>
                                <property name="can-focus">false</property>
                                <property name="can-target">false</property>
                              </object>
                            </child>
                            <property name="title" translatable="yes" context="Difficulty">_Very Hard</property>
                            <property name="use-underline">true</property>
                            <property name="activatable-widget">very_hard_check</property>
                            <signal name="activated" handler="difficulty_checkbutton_activated_cb" swapped="True"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStack" id="start_open_stack">
                        <property name="transition-type">crossfade</property>
                        <child>
                          <object class="GtkButton" id="start_button">
                            <property name="margin-top">12</property>
                            <property name="halign">center</property>
                            <property name="label" translatable="yes">_Start Game</property>
                            <property name="use-underline">true</property>
                            <property name="action-name">app.start-generated-game</property>
                            <style>
                              <class name="pill"/>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="open_and_shared_box">
                            <property name="margin-top">12</property>
                            <property name="spacing">12</property>
                            <property name="homogeneous">true</property>
                            <child>
                              <object class="GtkButton" id="open_button_round">
                                <property name="hexpand">true</property>
                                <property name="label" translatable="yes">_Open...</property>
                                <property name="can-shrink">true</property>
                                <property name="use-underline">true</property>
                                <signal name="clicked" handler="open_file_cb" swapped="True"/>
                                <style>
                                  <class name="round"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="start_shared_button">
                                <property name="label" translatable="yes">_Start Shared Game</property>
                                <property name="hexpand">true</property>
                                <property name="can-shrink">true</property>
                                <property name="use-underline">true</property>
                                <signal name="clicked" handler="start_shared_game_cb" swapped="True"/>
                                <style>
                                  <class name="round"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="open_button_pill">
                            <property name="margin-top">12</property>
                            <property name="halign">center</property>
                            <property name="label" translatable="yes">_Open…</property>
                            <property name="use-underline">true</property>
                            <signal name="clicked" handler="open_file_cb" swapped="True"/>
                            <style>
                              <class name="pill"/>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
