<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <menu id="primary-menu">
    <section id="controls-menu">
      <item>
        <attribute name="label" translatable="yes">_New Game…</attribute>
        <attribute name="action">app.new-game</attribute>
      </item>
      <submenu>
        <attribute name="label" translatable="yes">_Puzzle</attribute>
        <section>
          <item>
            <attribute name="label" translatable="yes">_Reset</attribute>
            <attribute name="action">game-view.reset-board</attribute>
          </item>
        </section>
        <section>
          <item>
            <attribute name="label" translatable="yes">_Share</attribute>
            <attribute name="action">game-view.share-puzzle</attribute>
          </item>
          <item>
            <attribute name="label" translatable="yes">_Save As…</attribute>
            <attribute name="action">game-view.save-game-as</attribute>
          </item>
          <item>
            <attribute name="label" translatable="yes">_Export…</attribute>
            <attribute name="action">game-view.export-puzzle</attribute>
          </item>
        </section>
        <section>
          <item>
            <attribute name="label" translatable="yes">Print _Generator</attribute>
            <attribute name="action">app.print-generator-dialog</attribute>
          </item>
        </section>
      </submenu>
    </section>
    <section>
      <section>
        <attribute name="label" translatable="yes">Zoom</attribute>
        <attribute name="display-hint">inline-buttons</attribute>
        <item>
          <attribute name="custom">zoom-out</attribute>
        </item>
        <item>
          <attribute name="custom">zoom-in</attribute>
        </item>
        <item>
          <attribute name="custom">menu-fullscreen</attribute>
        </item>
      </section>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences-dialog</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts-dialog</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Rascacielos</attribute>
        <attribute name="action">app.about-dialog</attribute>
      </item>
    </section>
  </menu>
  <template class="SudokuMenuButton" parent="AdwBin">
    <child>
      <object class="GtkMenuButton">
        <property name="icon-name">open-menu-symbolic</property>
        <property name="primary">true</property>
        <property name="tooltip-text" translatable="yes">Main Menu</property>
        <property name="popover">
          <object class="GtkPopoverMenu" id="main_menu">
            <property name="menu-model">primary-menu</property>
            <child type="zoom-out">
              <object class="GtkButton" id="zoom_out_button">
                <property name="icon-name">zoom-out-symbolic</property>
                <property name="action-name">app.zoom-out</property>
                <property name="tooltip-text" translatable="yes">Zoom Out</property>
                <style>
                  <class name="flat"/>
                  <class name="circular"/>
                </style>
              </object>
            </child>
            <child type="zoom-in">
              <object class="GtkButton" id="zoom_in_button">
                <property name="icon-name">zoom-in-symbolic</property>
                <property name="action-name">app.zoom-in</property>
                <property name="tooltip-text" translatable="yes">Zoom In</property>
                <style>
                  <class name="flat"/>
                  <class name="circular"/>
                </style>
              </object>
            </child>
            <child type="menu-fullscreen">
              <object class="GtkStack" id="menu_fullscreen_stack">
                <property name="transition-type">crossfade</property>
                <child>
                  <object class="GtkButton" id="menu_fullscreen_button">
                    <property name="icon-name">view-fullscreen-symbolic</property>
                    <property name="action-name">app.toggle-fullscreen</property>
                    <property name="tooltip-text" translatable="yes">Fullscreen</property>
                    <style>
                      <class name="flat"/>
                      <class name="circular"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="menu_unfullscreen_button">
                    <property name="icon-name">view-restore-symbolic</property>
                    <property name="action-name">app.toggle-fullscreen</property>
                    <property name="tooltip-text" translatable="yes">Leave Fullscreen</property>
                    <style>
                      <class name="flat"/>
                      <class name="circular"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
