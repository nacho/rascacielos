<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="GSettings" id="settings">
    <property name="schema-id">io.github.nacho.rascacielos</property>
  </object>
  <template class="SudokuWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Rascacielos</property>
    <property name="content">
      <object class="AdwViewStack" id="view_stack">
        <property name="enable-transitions">true</property>
        <child>
          <object class="SudokuGameView" id="game_view"/>
        </child>
        <child>
          <object class="SudokuStartView" id="start_view"/>
        </child>
      </object>
    </property>
  </template>
</interface>
