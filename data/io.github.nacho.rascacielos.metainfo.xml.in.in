<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Rascacielos</name>
  <summary>Place the skyscrapers in the city</summary>
  <description>
    <p>
      Rascacielos is a skyscrapers logic puzzle. Fill the grid with buildings
      so that each row and column holds every height once, and the numbers
      around the edge match how many buildings can be seen from that side.
    </p>
    <p>Features:</p>
    <ul>
      <li>Endless puzzles from 4×4 to 7×7 in four difficulties, each with a single solution.</li>
      <li>Pencil marks, undo and redo, and warnings for repeated heights and broken clues.</li>
      <li>Highscores and a timer for every size and difficulty.</li>
      <li>Your game is saved and restored automatically.</li>
      <li>Share puzzles with a short code, or export and open them as text.</li>
      <li>Print puzzles to solve on paper.</li>
    </ul>
    <p>
      Rascacielos is based on GNOME Sudoku by Thomas M. Hinkle, Robert Ancell,
      Parin Porecha, Jamie Murphy, Johan Gay and contributors.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/nacho/rascacielos/main/data/screenshots/screenshot.png</image>
      <caption>A 5×5 puzzle with its clues around the grid</caption>
    </screenshot>
    <screenshot environment="gnome:dark">
      <image>https://raw.githubusercontent.com/nacho/rascacielos/main/data/screenshots/screenshot-dark.png</image>
      <caption>A 5×5 puzzle in dark mode with a repeated height marked in red</caption>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
  <url type="homepage">https://github.com/nacho/rascacielos</url>
  <url type="bugtracker">https://github.com/nacho/rascacielos/issues</url>
  <url type="vcs-browser">https://github.com/nacho/rascacielos</url>
  <translation type="gettext">rascacielos</translation>
  <developer id="io.github.nacho">
    <name>Ignacio Casal Quinteiro</name>
  </developer>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <content_rating type="oars-1.1" />
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <releases>
    <release version="0.1.0" date="2026-11-17" type="stable">
      <description>
        <p>First release.</p>
        <ul>
          <li>Skyscrapers puzzles from 4×4 to 7×7 in four difficulties.</li>
          <li>Pencil marks, warnings, highscores, sharing and printing, inherited from GNOME Sudoku.</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
