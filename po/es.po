#: data/io.github.nacho.rascacielos.gschema.xml:10
msgid "Initialize the earmarks with the possible values for each cell"
msgstr "Inicializar las anotaciones con los valores posibles de cada celda"

#: data/io.github.nacho.rascacielos.gschema.xml:17
msgid ""
"Check for duplicates in rows and columns and for clues that do not match "
"full lines"
msgstr ""
"Comprobar si hay duplicados en filas y columnas y pistas que no coinciden "
"con líneas completas"

#: data/io.github.nacho.rascacielos.gschema.xml:21
msgid "Check earmarks against duplicates in row and column"
msgstr "Comprobar las anotaciones contra duplicados en fila y columna"

#: data/io.github.nacho.rascacielos.gschema.xml:25
msgid "Warn as soon as the buildings placed next to a clue contradict it"
msgstr ""
"Avisar en cuanto los edificios colocados junto a una pista la contradigan"

#: data/io.github.nacho.rascacielos.gschema.xml:29
msgid "Toggle timer and pause buttons"
msgstr "Mostrar el cronómetro y los botones de pausa"

#: data/io.github.nacho.rascacielos.gschema.xml:33
msgid "Additionally check against the solution for warnings"
msgstr "Comprobar también contra la solución para los avisos"

#: data/io.github.nacho.rascacielos.gschema.xml:37
msgid "Automatically clear related earmarks on new number insertion"
msgstr ""
"Borrar automáticamente las anotaciones relacionadas al introducir un número"

