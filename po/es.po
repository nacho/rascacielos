#: data/io.github.nacho.rascacielos.gschema.xml:49
msgid "Highlight the selected cell's matching numbers"
msgstr "Resaltar los números iguales al de la celda seleccionada"

#: data/io.github.nacho.rascacielos.gschema.xml:53
msgid "Zoom level"
msgstr "Nivel de ampliación"

#: data/io.github.nacho.rascacielos.gschema.xml:57
msgid "Width of the window in pixels"
msgstr "Anchura de la ventana en píxeles"

#: data/io.github.nacho.rascacielos.gschema.xml:61
msgid "Height of the window in pixels"
